# Lemon Squeezy (online ödeme — test modunda geliştirin)
# LEMONSQUEEZY_API_KEY=
# LEMONSQUEEZY_STORE_ID=
# LEMONSQUEEZY_WEBHOOK_SECRET=
# LEMONSQUEEZY_TEST_MODE=true
# Ödeme sayfası ürün görseli (PNG/JPG URL — Lemon paneli veya public klasör)
# LEMONSQUEEZY_DEFAULT_PRODUCT_IMAGE=https://www.cokusta.com/images/brand/kontor-odeme.png
# Paket bazlı görsel (opsiyonel): LEMONSQUEEZY_MEDIA_KONTOR_10=https://...
# Lemon Dashboard → Settings → Store → Logo (checkout logo: true için mağaza logosu)
# Her paket için Lemon variant ID (Dashboard → Products → Variant ID)
# LEMONSQUEEZY_VARIANT_KONTOR_5=
# LEMONSQUEEZY_VARIANT_KONTOR_10=
# LEMONSQUEEZY_VARIANT_KONTOR_25=
# LEMONSQUEEZY_VARIANT_KONTOR_50=
# LEMONSQUEEZY_VARIANT_KONTOR_100=
# LEMONSQUEEZY_VARIANT_KONTOR_TEK=
# LEMONSQUEEZY_VARIANT_ONE_CIKARMA=
# LEMONSQUEEZY_VARIANT_DOGRULANMIS_ROZET=
# Webhook URL (Vercel): https://www.cokusta.com/api/webhooks/lemon-squeezy

# Admin paneli giriş şifresi (üretimde zorunlu, en az 8 karakter)
ADMIN_PASSWORD=guclu-sifre-belirleyin

# Oturum imzalama anahtarı (üretimde zorunlu, en az 32 karakter — rastgele üretin)
# Örnek: openssl rand -hex 32
ADMIN_SESSION_SECRET=degistir-bunu-en-az-32-karakterlik-guclu-rastgele-anahtar

# Platform komisyon oranı (0.13 = %13, piyasa ~%20'nin %35 altı)
PLATFORM_COMMISSION_RATE=0.13

# KDV oranı (0.20 = %20)
PLATFORM_VAT_RATE=0.20

# Neon PostgreSQL — Vercel'de POOLLED link kullanın (host içinde -pooler geçer)
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
# DIRECT_URL=postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Vercel Blob (portfolyo fotoğrafları) — Vercel panelden Blob store ekleyince otomatik gelir
# BLOB_READ_WRITE_TOKEN=

# Canlı site adresi (SEO sitemap & metadata)
NEXT_PUBLIC_SITE_URL=https://www.cokusta.com

# Şirket bilgileri (fatura & beyanname)
COMPANY_NAME=Çokusta Teknoloji
COMPANY_TAX_NUMBER=9330231496
COMPANY_TAX_OFFICE=Ali Fuat Cebesoy
COMPANY_ADDRESS=Hanlı Merkez Mah. Anıl Sok. No:7, Arifiye / Sakarya
COMPANY_EMAIL=destek@cokusta.com
COMPANY_PHONE=+90 555 526 9770
