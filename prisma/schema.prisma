generator client {
provider        = "prisma-client-js"
  previewFeatures = [] 
  binaryTargets   = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum QuoteStatus {
  awaiting_review
  open
  accepted
  completed
  cancelled
}

enum OfferStatus {
  pending
  accepted
  rejected
  withdrawn
}

enum OfferReviewStatus {
  pending
  approved
  rejected
}

enum ProviderStatus {
  pending
  approved
  rejected
}

enum CreditPurchaseStatus {
  pending
  completed
  failed
}

enum PurchaseStatus {
  active
  expired
  cancelled
}

enum InvoiceReferenceType {
  quote
  platform_purchase @map("platform-purchase")
  customer_purchase @map("customer-purchase")
  provider_payout @map("provider-payout")
}

enum CreditLedgerType {
  customer_purchase
  customer_payment
  customer_escrow_payment
  provider_escrow_release
  provider_offer_spend
  provider_offer_debt
  provider_purchase
  provider_payout_request
  provider_payout_paid
  provider_payout_fee
  referral_grant
  launch_bonus
  provider_of_month_grant
  debt_settlement
  admin_adjustment
}

enum CustomerCreditPurchaseStatus {
  pending
  completed
  failed
}

enum JobEscrowReleaseStatus {
  none
  requested
  released
}

enum CustomerProviderPaymentStatus {
  pending
  completed
  cancelled
}

enum ProviderPayoutStatus {
  pending
  approved
  paid
  rejected
  cancelled
}

enum CertificateType {
  master_craftsman
  provider_of_month
}

model QuoteRequest {
  id                  String      @id @db.VarChar(64)
  serviceSlug         String      @map("service_slug") @db.VarChar(128)
  serviceName         String      @map("service_name") @db.VarChar(255)
  categoryName        String      @map("category_name") @db.VarChar(128)
  answers             Json
  city                String      @db.VarChar(128)
  district            String      @db.VarChar(128)
  name                String      @db.VarChar(255)
  phone               String      @db.VarChar(32)
  email               String      @db.VarChar(255)
  notes               String      @db.Text
  createdAt           DateTime    @map("created_at")
  status              QuoteStatus @default(open)
  matchedProviderId   String?     @map("matched_provider_id") @db.VarChar(64)
  matchedProviderName String?     @map("matched_provider_name") @db.VarChar(255)
  jobValue            Int?        @map("job_value")
  commissionRate      Float?      @map("commission_rate")
  commissionAmount    Int?        @map("commission_amount")
  completedAt         DateTime?   @map("completed_at")
  invoiceId           String?     @map("invoice_id") @db.VarChar(64)
  priorityListing     Boolean     @default(false) @map("priority_listing")
  launchMemberNumber  Int?        @map("launch_member_number")
  urgent              Boolean     @default(false)
  urgentDeadline      DateTime?   @map("urgent_deadline")
  customerPaidCredits Int?        @map("customer_paid_credits")
  customerPaymentAt   DateTime?   @map("customer_payment_at")
  escrowPaidAmount    Int?        @map("escrow_paid_amount")
  escrowServiceFee    Int?        @map("escrow_service_fee")

  matchedProvider Provider? @relation(fields: [matchedProviderId], references: [id], onDelete: SetNull)
  offers            ProviderOffer[]
  customerPayments  CustomerProviderPayment[]
  jobEscrowOrders   CustomerJobEscrowOrder[]
  offerReviews      ProviderOfferReview[]

  @@index([status])
  @@index([phone])
  @@index([createdAt])
  @@index([matchedProviderId])
  @@map("quote_requests")
}

model ProviderOffer {
  id               String      @id @db.VarChar(64)
  quoteRequestId   String      @map("quote_request_id") @db.VarChar(64)
  providerId       String      @map("provider_id") @db.VarChar(64)
  price            Int
  message          String      @db.Text
  estimatedDays    Int?        @map("estimated_days")
  status           OfferStatus @default(pending)
  createdAt        DateTime    @map("created_at")
  negotiation      Json        @default("[]")
  customerAgreedAt DateTime?   @map("customer_agreed_at")
  providerAgreedAt DateTime?   @map("provider_agreed_at")
  customerInitiatedContactAt DateTime? @map("customer_initiated_contact_at")

  quoteRequest QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  provider     Provider     @relation(fields: [providerId], references: [id], onDelete: Cascade)
  customerPayment CustomerProviderPayment?
  jobEscrowOrder  CustomerJobEscrowOrder?
  review          ProviderOfferReview?

  @@unique([quoteRequestId, providerId])
  @@index([quoteRequestId])
  @@index([providerId])
  @@index([status])
  @@map("provider_offers")
}

model Provider {
  id                 String         @id @db.VarChar(64)
  name               String         @db.VarChar(255)
  companyName        String?        @map("company_name") @db.VarChar(255)
  phone              String         @db.VarChar(32)
  email              String         @db.VarChar(255)
  city               String         @db.VarChar(128)
  district           String?        @db.VarChar(128)
  categorySlugs      Json           @map("category_slugs")
  experience         String         @db.Text
  bio                String         @db.Text
  createdAt          DateTime       @map("created_at")
  status             ProviderStatus @default(pending)
  reviewedAt         DateTime?      @map("reviewed_at")
  rejectionReason    String?        @map("rejection_reason") @db.Text
  creditBalance      Int            @default(0) @map("credit_balance")
  creditDebt         Int            @default(0) @map("credit_debt")
  borcKredisiAktif   Boolean        @default(false) @map("borc_kredisi_aktif")
  launchMemberNumber Int?           @map("launch_member_number")
  launchBonusGranted Boolean        @default(false) @map("launch_bonus_granted")
  pinHash            String?        @map("pin_hash") @db.VarChar(128)
  iban               String?        @db.VarChar(34)
  accountHolder      String?        @map("account_holder") @db.VarChar(255)
  escrowBalanceTl    Int            @default(0) @map("escrow_balance_tl")

  quotes            QuoteRequest[]
  offers            ProviderOffer[]
  portfolio         ProviderPortfolioItem[]
  platformPurchases ProviderPlatformPurchase[]
  certificates      ProviderCertificate[]
  creditPurchases   CreditPurchaseOrder[]
  referralsMade     ProviderReferral[] @relation("ReferralsMade")
  referredVia       ProviderReferral?  @relation("ReferredAsFriend")
  customerPayments  CustomerProviderPayment[]
  jobEscrowOrders   CustomerJobEscrowOrder[]
  inboxMessages     ProviderInboxMessage[]
  payoutRequests    ProviderPayoutRequest[]
  creditLedger      CreditLedgerEntry[]
  offerReviews      ProviderOfferReview[]

  @@index([status])
  @@index([phone])
  @@index([createdAt])
  @@map("providers")
}

model ProviderOfferReview {
  id             String            @id @db.VarChar(64)
  quoteRequestId String            @map("quote_request_id") @db.VarChar(64)
  offerId        String            @unique @map("offer_id") @db.VarChar(64)
  providerId     String            @map("provider_id") @db.VarChar(64)
  customerPhone  String            @map("customer_phone") @db.VarChar(32)
  rating         Int
  comment        String            @db.Text
  reviewerLabel  String            @map("reviewer_label") @db.VarChar(128)
  serviceName    String            @map("service_name") @db.VarChar(255)
  status         OfferReviewStatus @default(pending)
  createdAt      DateTime          @map("created_at")
  moderatedAt    DateTime?         @map("moderated_at")

  offer        ProviderOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  provider     Provider      @relation(fields: [providerId], references: [id], onDelete: Cascade)
  quoteRequest QuoteRequest  @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)

  @@index([providerId, createdAt])
  @@index([quoteRequestId])
  @@index([status, createdAt])
  @@map("provider_offer_reviews")
}

model ProviderReferral {
  id                 String    @id @db.VarChar(64)
  referrerId         String    @map("referrer_id") @db.VarChar(64)
  referredPhone      String    @unique @map("referred_phone") @db.VarChar(32)
  referredName       String    @default("") @map("referred_name") @db.VarChar(255)
  categorySlug       String    @default("") @map("category_slug") @db.VarChar(128)
  serviceSlugs       Json      @default("[]") @map("service_slugs")
  referredProviderId String?   @unique @map("referred_provider_id") @db.VarChar(64)
  creditsAwarded     Int       @default(5) @map("credits_awarded")
  createdAt          DateTime  @map("created_at")

  referrer         Provider  @relation("ReferralsMade", fields: [referrerId], references: [id], onDelete: Cascade)
  referredProvider Provider? @relation("ReferredAsFriend", fields: [referredProviderId], references: [id], onDelete: SetNull)

  @@index([referrerId])
  @@map("provider_referrals")
}

model CreditPurchaseOrder {
  id              String               @id @db.VarChar(64)
  providerId      String               @map("provider_id") @db.VarChar(64)
  packageSlug     String               @map("package_slug") @db.VarChar(64)
  packageName     String               @map("package_name") @db.VarChar(255)
  credits         Int
  packageAmount   Int              @default(0) @map("package_amount")
  debtCredits     Int              @default(0) @map("debt_credits")
  amount          Int
  conversationId  String               @unique @map("conversation_id") @db.VarChar(64)
  basketId        String               @map("basket_id") @db.VarChar(64)
  status          CreditPurchaseStatus @default(pending)
  iyzicoToken     String?              @map("iyzico_token") @db.VarChar(512)
  iyzicoPaymentId String?              @map("iyzico_payment_id") @db.VarChar(64)
  purchaseId      String?              @map("purchase_id") @db.VarChar(64)
  createdAt       DateTime             @map("created_at")
  completedAt     DateTime?            @map("completed_at")

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@index([status])
  @@index([createdAt])
  @@map("credit_purchase_orders")
}

model LemonWebhookLog {
  id                   String   @id @db.VarChar(64)
  eventName            String   @map("event_name") @db.VarChar(64)
  conversationId       String?  @map("conversation_id") @db.VarChar(64)
  orderId              String?  @map("order_id") @db.VarChar(64)
  lemonOrderId         String?  @map("lemon_order_id") @db.VarChar(64)
  providerId           String?  @map("provider_id") @db.VarChar(64)
  testMode             Boolean  @default(false) @map("test_mode")
  outcome              String   @db.VarChar(32)
  orderStatusBefore    String?  @map("order_status_before") @db.VarChar(32)
  orderStatusAfter     String?  @map("order_status_after") @db.VarChar(32)
  creditsGranted       Int?     @map("credits_granted")
  providerCreditBefore Int?     @map("provider_credit_before")
  providerCreditAfter  Int?     @map("provider_credit_after")
  dbVerified           Boolean  @default(false) @map("db_verified")
  errorMessage         String?  @map("error_message") @db.Text
  responseSummary      String?  @map("response_summary") @db.Text
  createdAt            DateTime @map("created_at")

  @@index([conversationId])
  @@index([orderId])
  @@index([outcome])
  @@index([createdAt])
  @@map("lemon_webhook_logs")
}

model ProviderPortfolioItem {
  id          String   @id @db.VarChar(64)
  providerId  String   @map("provider_id") @db.VarChar(64)
  title       String   @db.VarChar(255)
  description String   @db.Text
  imageUrl    String   @map("image_url") @db.VarChar(512)
  serviceSlug String?  @map("service_slug") @db.VarChar(128)
  createdAt   DateTime @map("created_at")

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@index([serviceSlug])
  @@map("provider_portfolio_items")
}

model ProviderPlatformPurchase {
  id          String         @id @db.VarChar(64)
  providerId  String         @map("provider_id") @db.VarChar(64)
  serviceSlug String         @map("service_slug") @db.VarChar(128)
  serviceName String         @map("service_name") @db.VarChar(255)
  amount      Int
  purchasedAt DateTime       @map("purchased_at")
  status      PurchaseStatus @default(active)
  invoiceId   String?        @map("invoice_id") @db.VarChar(64)

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@index([status])
  @@map("provider_platform_purchases")
}

model Customer {
  id        String   @id @db.VarChar(64)
  name      String   @db.VarChar(255)
  phone     String   @db.VarChar(32)
  email     String   @db.VarChar(255)
  city      String   @db.VarChar(128)
  notes     String?  @db.Text
  createdAt DateTime @map("created_at")

  @@index([phone])
  @@map("customers")
}

model CustomerWallet {
  id            String   @id @db.VarChar(64)
  phone         String   @unique @db.VarChar(32)
  creditBalance Int      @default(0) @map("credit_balance")
  pinHash       String?  @map("pin_hash") @db.VarChar(128)
  city          String?  @db.VarChar(128)
  district      String?  @db.VarChar(128)
  createdAt     DateTime @map("created_at")
  updatedAt     DateTime @map("updated_at")

  purchases CustomerCreditPurchaseOrder[]
  payments  CustomerProviderPayment[]
  ledger    CreditLedgerEntry[]

  @@map("customer_wallets")
}

model CustomerCreditPurchaseOrder {
  id              String                       @id @db.VarChar(64)
  walletId        String                       @map("wallet_id") @db.VarChar(64)
  packageSlug     String                       @map("package_slug") @db.VarChar(64)
  packageName     String                       @map("package_name") @db.VarChar(255)
  credits         Int
  amount          Int
  conversationId  String                       @unique @map("conversation_id") @db.VarChar(64)
  basketId        String                       @map("basket_id") @db.VarChar(64)
  status          CustomerCreditPurchaseStatus @default(pending)
  iyzicoToken     String?                      @map("iyzico_token") @db.VarChar(512)
  iyzicoPaymentId String?                      @map("iyzico_payment_id") @db.VarChar(64)
  createdAt       DateTime                     @map("created_at")
  completedAt     DateTime?                    @map("completed_at")

  wallet CustomerWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([status])
  @@map("customer_credit_purchase_orders")
}

model CustomerProviderPayment {
  id             String                      @id @db.VarChar(64)
  quoteRequestId String                      @map("quote_request_id") @db.VarChar(64)
  offerId        String                      @map("offer_id") @db.VarChar(64)
  walletId       String                      @map("wallet_id") @db.VarChar(64)
  providerId     String                      @map("provider_id") @db.VarChar(64)
  credits        Int
  tlEquivalent   Int                         @map("tl_equivalent")
  status         CustomerProviderPaymentStatus @default(completed)
  createdAt      DateTime                    @map("created_at")

  quoteRequest QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  offer        ProviderOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  wallet       CustomerWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  provider     Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([quoteRequestId])
  @@unique([offerId])
  @@index([providerId])
  @@index([walletId])
  @@map("customer_provider_payments")
}

model CustomerJobEscrowOrder {
  id              String                       @id @db.VarChar(64)
  quoteRequestId  String                       @unique @map("quote_request_id") @db.VarChar(64)
  offerId         String                       @unique @map("offer_id") @db.VarChar(64)
  customerPhone   String                       @map("customer_phone") @db.VarChar(32)
  providerId      String                       @map("provider_id") @db.VarChar(64)
  jobAmount       Int                          @map("job_amount")
  serviceFee      Int                          @map("service_fee")
  totalAmount     Int                          @map("total_amount")
  conversationId  String                       @unique @map("conversation_id") @db.VarChar(64)
  basketId        String                       @map("basket_id") @db.VarChar(64)
  status          CustomerCreditPurchaseStatus @default(pending)
  iyzicoToken     String?                      @map("iyzico_token") @db.VarChar(512)
  iyzicoPaymentId String?                      @map("iyzico_payment_id") @db.VarChar(64)
  createdAt       DateTime                     @map("created_at")
  completedAt     DateTime?                    @map("completed_at")
  releaseStatus   JobEscrowReleaseStatus       @default(none) @map("release_status")
  releaseRequestedAt DateTime?                 @map("release_requested_at")
  releasedAt      DateTime?                    @map("released_at")

  quoteRequest QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  offer        ProviderOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  provider     Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@index([customerPhone])
  @@index([status])
  @@map("customer_job_escrow_orders")
}

model ProviderInboxMessage {
  id             String   @id @db.VarChar(64)
  providerId     String   @map("provider_id") @db.VarChar(64)
  type           String   @db.VarChar(64)
  title          String   @db.VarChar(255)
  body           String   @db.Text
  quoteRequestId String?  @map("quote_request_id") @db.VarChar(64)
  read           Boolean  @default(false)
  createdAt      DateTime @map("created_at")

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@index([read])
  @@index([createdAt])
  @@map("provider_inbox_messages")
}

model ProviderPayoutRequest {
  id               String              @id @db.VarChar(64)
  providerId       String              @map("provider_id") @db.VarChar(64)
  period           String              @db.VarChar(16)
  creditsRequested Int                 @map("credits_requested")
  grossAmount      Int                 @map("gross_amount")
  feeAmount        Int                 @map("fee_amount")
  netAmount        Int                 @map("net_amount")
  status           ProviderPayoutStatus @default(pending)
  iban             String?             @db.VarChar(34)
  accountHolder    String?             @map("account_holder") @db.VarChar(255)
  adminNote        String?             @map("admin_note") @db.Text
  requestedAt      DateTime            @map("requested_at")
  processedAt      DateTime?           @map("processed_at")

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@index([period])
  @@index([status])
  @@map("provider_payout_requests")
}

model CreditLedgerEntry {
  id               String           @id @db.VarChar(64)
  type             CreditLedgerType
  creditsDelta     Int              @map("credits_delta")
  tlAmount         Int?             @map("tl_amount")
  customerWalletId String?          @map("customer_wallet_id") @db.VarChar(64)
  providerId       String?          @map("provider_id") @db.VarChar(64)
  quoteRequestId   String?          @map("quote_request_id") @db.VarChar(64)
  referenceId      String?          @map("reference_id") @db.VarChar(64)
  description      String           @db.Text
  period           String           @db.VarChar(16)
  createdAt        DateTime         @map("created_at")

  customerWallet CustomerWallet? @relation(fields: [customerWalletId], references: [id], onDelete: SetNull)
  provider       Provider?       @relation(fields: [providerId], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([period])
  @@index([providerId])
  @@index([customerWalletId])
  @@index([createdAt])
  @@map("credit_ledger_entries")
}

model Invoice {
  id             String               @id @db.VarChar(64)
  invoiceNo      String               @map("invoice_no") @db.VarChar(64)
  referenceType  InvoiceReferenceType @map("reference_type")
  referenceId    String               @map("reference_id") @db.VarChar(64)
  recipientName  String               @map("recipient_name") @db.VarChar(255)
  recipientEmail String?              @map("recipient_email") @db.VarChar(255)
  recipientPhone String?              @map("recipient_phone") @db.VarChar(32)
  description    String               @db.Text
  subtotal       Float
  vatRate        Float                @map("vat_rate")
  vatAmount      Float                @map("vat_amount")
  total          Float
  period         String               @db.VarChar(16)
  issuedAt       DateTime             @map("issued_at")

  @@unique([referenceType, referenceId])
  @@index([period])
  @@index([issuedAt])
  @@map("invoices")
}

model TaxDeclaration {
  id            String   @id @db.VarChar(64)
  period        String   @unique @db.VarChar(16)
  periodLabel   String   @map("period_label") @db.VarChar(64)
  invoiceCount  Int      @map("invoice_count")
  taxableBase   Float    @map("taxable_base")
  calculatedVat Float    @map("calculated_vat")
  totalAmount   Float    @map("total_amount")
  createdAt     DateTime @map("created_at")

  @@map("tax_declarations")
}

model ProviderCertificate {
  id           String          @id @db.VarChar(64)
  providerId   String          @map("provider_id") @db.VarChar(64)
  providerName String          @map("provider_name") @db.VarChar(255)
  type         CertificateType
  title        String          @db.VarChar(255)
  description  String          @db.Text
  period       String?         @db.VarChar(16)
  issuedAt     DateTime        @map("issued_at")
  blockIndex   Int             @map("block_index")
  blockHash    String          @map("block_hash") @db.VarChar(128)
  previousHash String          @map("previous_hash") @db.VarChar(128)
  metadata     Json

  provider           Provider             @relation(fields: [providerId], references: [id], onDelete: Cascade)
  providerOfTheMonth ProviderOfTheMonth[]

  @@index([providerId])
  @@index([type])
  @@map("provider_certificates")
}

model CertificateBlock {
  index         Int      @id
  timestamp     DateTime
  certificateId String   @map("certificate_id") @db.VarChar(64)
  data          String   @db.Text
  previousHash  String   @map("previous_hash") @db.VarChar(128)
  hash          String   @db.VarChar(128)

  @@map("certificate_blocks")
}

enum ProviderOfMonthStatus {
  pending
  published
  removed
}

model ProviderOfTheMonth {
  period         String                 @id @db.VarChar(16)
  periodLabel    String                 @map("period_label") @db.VarChar(64)
  providerId     String                 @map("provider_id") @db.VarChar(64)
  providerName   String                 @map("provider_name") @db.VarChar(255)
  certificateId  String                 @unique @map("certificate_id") @db.VarChar(64)
  selectedAt     DateTime               @map("selected_at")
  reason         String?                @db.Text
  status         ProviderOfMonthStatus  @default(pending)
  creditsAwarded Int                    @default(0) @map("credits_awarded")
  publishedAt    DateTime?              @map("published_at")

  certificate ProviderCertificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)

  @@index([selectedAt])
  @@index([status])
  @@map("provider_of_the_month_history")
}